# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` for development; set the same keys in the Vercel
# project's Environment Variables for a deployment. `.env*` is gitignored —
# never commit real values.
#
# Nothing here throws at import time. An unset key degrades that one feature
# with a clear message; the rest of the site keeps working.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Substitute the password directly rather
# than leaving a <password> placeholder to swap at runtime.
# Under Network Access, allow Vercel's egress (0.0.0.0/0 unless you have a
# static-IP setup) or every connection from a deployment is refused.
MONGODB_URI=
# Optional. Serverless instances handle one request at a time, so a large pool
# per instance is waste multiplied by the instance count.
MONGODB_MAX_POOL_SIZE=5

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# SMTP_PASSWORD must be a 16-character Google App Password, NOT the account
# password — Google disabled password auth for SMTP in May 2022.
# Generate one at https://myaccount.google.com/apppasswords (needs 2FA on).
SMTP_USER=thesoftnode@gmail.com
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail rewrites the From header to the authenticated account unless this is a
# verified alias (Gmail → Settings → Accounts → "Send mail as"). Setting a
# docerity.com address before that alias exists does not make mail appear to
# come from it. Leave unset to send as SMTP_USER.
SMTP_FROM=

# Where enquiry notifications land. Defaults to SMTP_USER.
CONTACT_TO_EMAIL=

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Dashboard → Account Details. The API secret signs uploads and must never
# reach the browser, which is why there is no NEXT_PUBLIC_ variant here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional folder overrides.
CLOUDINARY_ENQUIRY_FOLDER=docerity/enquiries
CLOUDINARY_REVIEW_FOLDER=docerity/reviews

# ── Site ─────────────────────────────────────────────────────────────────────
# Used to build absolute links in email. Falls back to VERCEL_URL, then to the
# production domain.
NEXT_PUBLIC_SITE_URL=https://www.docerity.com
