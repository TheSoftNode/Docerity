# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` for development. In production set these in the Vercel
# project's Environment Variables. `.env*` is gitignored — never commit real
# values.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string, password already substituted.
# The portfolio backend stored a `<password>` placeholder and replaced it at
# runtime; put the real password in here instead so a missing second variable
# cannot produce a confusing auth failure.
# Atlas → Database → Connect → Drivers. Remember to allow Vercel's egress in
# Network Access (0.0.0.0/0 unless you have a static-IP setup).
MONGODB_URI=

# Transactional email. Create a key at https://resend.com/api-keys
# Without this the routes still save everything; they just log a warning
# instead of sending, so local development needs no key.
RESEND_API_KEY=

# Must be on a domain verified with Resend, or mail is rejected.
# Until docerity.com is verified, `onboarding@resend.dev` works but can only
# deliver to your own Resend account address.
CONTACT_FROM_EMAIL="Docerity <hello@docerity.com>"

# Where enquiry notifications land. Defaults to siteConfig.email if unset.
CONTACT_TO_EMAIL=thesoftnode@gmail.com

# Vercel Blob, for enquiry attachments. On Vercel, create a Blob store in the
# project's Storage tab and this is injected automatically. For local
# development pull it down with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# Admin area. Generate the secret with:  openssl rand -base64 32
# The password is hashed at rest in comparison only — set a long random one.
ADMIN_EMAIL=thesoftnode@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
